<?php

namespace App\Services;

use App\Models\Cola;
use App\Models\Medico;
use Carbon\Carbon;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Log;

class GeminiService
{
    protected string $apiKey;
    protected string $model;

    public function __construct()
    {
        $this->apiKey = config('services.gemini.api_key', '');
        $this->model  = config('services.gemini.model', 'gemini-1.5-flash');
    }

    public function procesarMensaje(string $mensajePaciente, string $telefonoRemitente): string
    {
        $url = "https://generativelanguage.googleapis.com/v1beta/models/{$this->model}:generateContent?key={$this->apiKey}";

        $systemInstruction = [
            'parts' => [
                ['text' => "Eres el asistente virtual oficial de Doctorisimo (antes Agenda Médica). Tu objetivo es atender a los pacientes por WhatsApp de forma amable, profesional y concisa. Si el paciente pregunta por disponibilidad de citas o cupos para un médico en una fecha, utiliza la función consultar_disponibilidad_cupos. Si no especifica el año, asume el año actual. Responde siempre bajo el nombre de Doctorisimo."]
            ]
        ];

        // Definición de la Tool (Function Calling)
        $tools = [
            [
                'function_declarations' => [
                    [
                        'name' => 'consultar_disponibilidad_cupos',
                        'description' => 'Consulta la disponibilidad de cupos en la agenda médica (tabla cola) para un médico en una fecha dada.',
                        'parameters' => [
                            'type' => 'OBJECT',
                            'properties' => [
                                'nombre_o_apellido_medico' => [
                                    'type' => 'STRING',
                                    'description' => 'Nombre, apellido o especialidad del médico a consultar.'
                                ],
                                'fecha' => [
                                    'type' => 'STRING',
                                    'description' => 'Fecha de la consulta en formato YYYY-MM-DD.'
                                ]
                            ],
                            'required' => ['nombre_o_apellido_medico', 'fecha']
                        ]
                    ]
                ]
            ]
        ];

        $payload = [
            'system_instruction' => $systemInstruction,
            'contents' => [
                [
                    'role' => 'user',
                    'parts' => [['text' => $mensajePaciente]]
                ]
            ],
            'tools' => $tools
        ];

        try {
            $response = Http::post($url, $payload);
            if (!$response->successful()) {
                Log::error('Error en Gemini API: ' . $response->body());
                return "Hola, bienvenido a Doctorisimo. En este momento tenemos problemas para consultar la disponibilidad. Por favor intenta más tarde.";
            }

            $data = $response->json();
            $candidate = $data['candidates'][0]['content']['parts'][0] ?? null;

            // Verificar si Gemini decidió llamar a la función
            if (isset($candidate['functionCall'])) {
                $functionCall = $candidate['functionCall'];
                $functionName = $functionCall['name'];
                $args = $functionCall['args'];

                if ($functionName === 'consultar_disponibilidad_cupos') {
                    $resultadoConsulta = $this->consultarDisponibilidadEnCola(
                        $args['nombre_o_apellido_medico'] ?? '',
                        $args['fecha'] ?? Carbon::today()->toDateString()
                    );

                    // Segunda llamada enviando la respuesta de la función para que Gemini redacte la respuesta final
                    $followUpPayload = [
                        'system_instruction' => $systemInstruction,
                        'contents' => [
                            ['role' => 'user', 'parts' => [['text' => $mensajePaciente]]],
                            ['role' => 'model', 'parts' => [$candidate]],
                            [
                                'role' => 'function',
                                'parts' => [
                                    [
                                        'functionResponse' => [
                                            'name' => 'consultar_disponibilidad_cupos',
                                            'response' => $resultadoConsulta
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ];

                    $followUpResponse = Http::post($url, $followUpPayload);
                    if ($followUpResponse->successful()) {
                        $followUpData = $followUpResponse->json();
                        return $followUpData['candidates'][0]['content']['parts'][0]['text'] ?? "No se pudo generar la respuesta.";
                    }
                }
            }

            return $candidate['text'] ?? "Hola, te contactas con Doctorisimo. ¿En qué podemos ayudarte?";
        } catch (\Throwable $e) {
            Log::error('Excepción en GeminiService: ' . $e->getMessage());
            return "Hola, bienvenido a Doctorisimo. Estamos experimentando inconvenientes técnicos. Intenta de nuevo en unos minutos.";
        }
    }

    /**
     * Consulta la tabla cola para verificar disponibilidad
     */
    protected function consultarDisponibilidadEnCola(string $terminoMedico, string $fecha): array
    {
        // 1. Buscar al médico por nombre o apellido
        $medico = Medico::where('nombres', 'like', "%{$terminoMedico}%")
            ->orWhere('apellidos', 'like', "%{$terminoMedico}%")
            ->first();

        if (!$medico) {
            return [
                'encontrado' => false,
                'mensaje' => "No se encontró ningún médico con el criterio '{$terminoMedico}' en Doctorisimo."
            ];
        }

        // 2. Consultar citas asignadas en la tabla cola para esa fecha y ese reg_medico
        // En el esquema legado: cola.reg_medico y cola.fecha
        $citas = Cola::where('reg_medico', $medico->reg_medico ?? $medico->id)
            ->whereDate('fecha', $fecha)
            ->get();

        // 3. Evaluar cupos (por ejemplo, límite habitual por turno/día vs. cantidad de registros en cola)
        $totalCitas = $citas->count();
        // Si la tabla cola o configuración médica tiene un cupo máximo configurado, se compara aquí;
        // por defecto asumimos un límite estimado o informamos cuántos pacientes hay citados
        $cuposDisponibles = max(0, 15 - $totalCitas); // Ejemplo: 15 cupos por turno

        return [
            'encontrado' => true,
            'medico' => "Dr(a). {$medico->nombres} {$medico->apellidos}",
            'fecha' => $fecha,
            'citas_agendadas' => $totalCitas,
            'cupos_disponibles' => $cuposDisponibles,
            'tiene_disponibilidad' => $cuposDisponibles > 0,
        ];
    }
}