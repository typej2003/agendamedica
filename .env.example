APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Secreto de la app de Meta (App settings → Basic). Valida la firma del webhook: **sin él el POST
# /api/whatsapp/webhook rechaza todo con 503** (no se acepta nada sin firma).
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0
# Plantilla aprobada en Meta para el código de la reserva pública (portal del paciente). Sin ella, el
# portal manda el código por SMS (Twilio) y, en local, lo simula y lo muestra en pantalla.
WHATSAPP_TEMPLATE_CODIGO=

# Jev AI — modelo de DECISIONES (prueba de concepto `php artisan jev:triaje`, ROADMAP §10.3).
# La clave vive acá, nunca en el código ni en un documento. Sin JEV_API_KEY el comando explica dónde va.
#   Jev AI (oficial):        https://thejevai.com          typesafe/jev-1.14       protocolo systemone
#   DigitalOcean Inference:  https://inference.do-ai.run   typesafe-jev-1.13.0     protocolo systemone
#   DefAPI (defapi.org):     https://api.defapi.org        typesafe/jev-1.13       decisions
#   OpenRouter:              https://openrouter.ai/api      typesafe/jev-1.14       openrouter
#     ⚠️ Su ruta de Jev es POST /alpha/decisions (no /v1/systemone, y el modelo NO está en chat/messages).
#        Con JEV_PROTOCOLO=openrouter manda OPENROUTER_API_KEY y JEV_BASE_URL se ignora: es la forma de
#        centralizar todo con OpenRouter.
#   `JEV_PROTOCOLO`: systemone | decisions | openrouter | chat | auto. `auto` prueba las dos rutas de
#   decisiones del mismo proveedor y cae a chat.
JEV_API_KEY=
JEV_BASE_URL=https://thejevai.com
JEV_MODEL=typesafe/jev-1.14
JEV_PROTOCOLO=auto
# Debajo de esta confianza la decisión se deriva a la secretaría en vez de automatizarse.
JEV_UMBRAL=0.7

# Chatbot de WhatsApp: urgencia afirmada por Jev y sin horario hoy -> aviso por correo a la secretaría (máximo uno
# por teléfono cada tantos minutos; el contacto del consultorio se le da a la paciente igual).
CHATBOT_URGENCIA_AVISO_MINUTOS=60
# Tope de mensajes por teléfono (40 en 5 minutos por defecto): protege el presupuesto de IA y el webhook.
CHATBOT_LIMITE_MENSAJES=40
CHATBOT_VENTANA_MENSAJES=300

# Proveedor de SMS de la web (WEB-2.6). La credencial es del **servidor**: los médicos no configuran
# proveedores de comunicación. Sin estas tres variables el envío de SMS responde 503 y lo dice.
#
# O-55: qué hay detrás de `SmsService`. `twilio` (el de siempre, si la variable no está), `log` (SÓLO
# desarrollo: el mensaje va al log y devuelve ok) o `ninguno` (apagado: las pantallas no ofrecen el canal).
SMS_PROVEEDOR=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# IA: chatbot de WhatsApp, lectura de hojas escaneadas y Jev.
# Un solo interruptor: gemini (por defecto) u openrouter. Con openrouter, OPENROUTER_API_KEY sirve para los
# tres usos y GEMINI_API_KEY deja de usarse. Cada uso se puede pisar por separado.
IA_PROVEEDOR=gemini
# CHATBOT_PROVEEDOR=openrouter
# OCR_PROVEEDOR=openrouter
# Para Jev, además: JEV_PROTOCOLO=openrouter (arriba, en el bloque JEV).

# OpenRouter (https://openrouter.ai/settings/keys). Modelo por defecto: Gemma 4 26B A4B.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# OPENROUTER_MODELO_OCR=   (sin definir: el de OPENROUTER_MODEL)
# Respaldos si el principal falla (429/5xx/timeout). Acepta JSON o lista separada por comas. Vacío = sin failover.
# El principal se antepone solo; acá van sólo los respaldos.
# OPENROUTER_MODELOS_FALLOVER=google/gemma-4-31b-it,openai/gpt-4o-mini
# OPENROUTER_MODELOS_OCR_FALLOVER=google/gemma-4-31b-it,openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_TITULO=AppDDR
# OPENROUTER_MAX_TOKENS=2000
# OPENROUTER_MAX_TOKENS_OCR=16000
# OPENROUTER_TEMPERATURA=   (sin definir: el preset del modelo; Gemma 4 trae 1)
# OPENROUTER_TEMPERATURA_OCR=0
# OPENROUTER_TIMEOUT=25
# OPENROUTER_TIMEOUT_OCR=90
# OPENROUTER_PDF_ENGINE=   (mistral-ocr | cloudflare-ai | native; en blanco: el de OpenRouter)

# Gemini: sólo si algún uso sigue en gemini. La lectura de hojas usa GEMINI_MODELO_OCR o, si está en blanco,
# GEMINI_MODEL. La clave tiene que ser de un proyecto con facturación (viajan hojas de pacientes).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# GEMINI_MODELO_OCR=   (sin definir: el de GEMINI_MODEL)

# Anthropic: alternativa para la lectura de hojas (OCR_PROVEEDOR=anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO_OCR=claude-opus-5-5
# Canal de publicacion del escritorio (instalador Standalone): la clave la genera
# php artisan escritorio:canal-clave --rotar. Los consultorios NO la usan: descargan sin credencial.
ESCRITORIO_CANAL_KEY=
# Base del API para publicar desde una PC de desarrollo (por defecto, APP_URL).
ESCRITORIO_URL=

# Link de descarga de la app en la landing /r/{codigo} (opcional).
LATIDOS_URL_DESCARGA=
